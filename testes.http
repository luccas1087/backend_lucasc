
@url = http://localhost:3000


### 1 - Listar todos os treinos            -> espera 200 e um array
GET {{url}}/treinos


### 2 - Criar um treino                    -> espera 201
POST {{url}}/treinos
Content-Type: application/json

{
    "nome": "Peito e triceps",
    "duracao": 60
}


### 3 - Criar outro treino                 -> espera 201
POST {{url}}/treinos
Content-Type: application/json

{
    "nome": "Costas e biceps",
    "duracao": 45
}


### 4 - Buscar o treino 1                  -> espera 200
GET {{url}}/treinos/1


### 5 - Buscar um treino que nao existe    -> espera 404
GET {{url}}/treinos/99999


### 6 - Criar sem o nome                   -> espera 400
POST {{url}}/treinos
Content-Type: application/json

{
    "duracao": 30
}


### 7 - Criar com duracao invalida         -> espera 400
POST {{url}}/treinos
Content-Type: application/json

{
    "nome": "Corrida",
    "duracao": -5
}


### 8 - Alterar o treino 1                 -> espera 200
PUT {{url}}/treinos/1
Content-Type: application/json

{
    "nome": "Peito, triceps e ombro",
    "duracao": 75
}


### 9 - Alterar um treino que nao existe   -> espera 404
PUT {{url}}/treinos/99999
Content-Type: application/json

{
    "nome": "Qualquer",
    "duracao": 10
}


### 10 - Apagar o treino 2                 -> espera 204 (sem corpo)
DELETE {{url}}/treinos/2


### 11 - Apagar um treino que nao existe   -> espera 404
DELETE {{url}}/treinos/99999


### 12 - Listar de novo pra conferir       -> espera 200
GET {{url}}/treinos



### Exercicio 7 - Contagem total de treinos -> espera 200 e {"total": ...}
GET {{url}}/treinos/total


### Exercicio 8 - Filtro por duracao minima -> espera 200 (apenas duracao >= 40)
GET {{url}}/treinos?minimo=40


### Exercicio 10 - Busca por nome            -> espera 200 (apenas com 'peito' no nome)
GET {{url}}/treinos?busca=peito


### Exercicio 8 + 10 - Filtro e Busca juntos -> espera 200
GET {{url}}/treinos?minimo=40&busca=peito


### Exercicio 11 - Resumo dos treinos        -> espera 200 e {"total": ..., "minutos": ..., "media": ...}
GET {{url}}/treinos/resumo


### Exercicio 12 - ID invalido (texto no GET) -> espera 400 (ID invalido)
GET {{url}}/treinos/abc


### Exercicio 12 - ID invalido no PUT        -> espera 400 (ID invalido)
PUT {{url}}/treinos/abc
Content-Type: application/json

{
    "nome": "Peito e triceps",
    "duracao": 60
}


### Exercicio 12 - ID invalido no DELETE     -> espera 400 (ID invalido)
DELETE {{url}}/treinos/abc

# ============================================================
# AULA 05 - SESSAO E COOKIE
# ============================================================

### Criar treino SEM login -> espera 401
POST {{url}}/treinos
Content-Type: application/json

{ "nome": "Sem login", "duracao": 20 }

### Login com senha certa -> 200 + Set-Cookie
POST {{url}}/login
Content-Type: application/json

{ "usuario": "diego", "senha": "1234" }

### Perfil -> 200 (diego)
GET {{url}}/perfil

### Criar treino logado -> 201
POST {{url}}/treinos
Content-Type: application/json

{ "nome": "Logado", "duracao": 20 }

### Logout -> 204
POST {{url}}/logout

### Perfil de novo -> 401
GET {{url}}/perfil

### Senha errada -> 401
POST {{url}}/login
Content-Type: application/json

{ "usuario": "diego", "senha": "errada" }

### Usuario inexistente -> 401 (mesma mensagem)
POST {{url}}/login
Content-Type: application/json

{ "usuario": "fantasma", "senha": "x" }

### Duas pessoas: logar como aluno -> perfil tem que ser "aluno"
POST {{url}}/login
Content-Type: application/json

{ "usuario": "aluno", "senha": "senha" }

### Perfil do aluno -> 200 (aluno)
GET {{url}}/perfil
